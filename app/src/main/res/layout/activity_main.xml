<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal"
    tools:context=".MainActivity">

    <!-- App Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GEOFENCE ALERT"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#2196F3"
        android:layout_marginBottom="24dp" />

    <!-- Geofence Status Display -->
    <TextView
        android:id="@+id/geofence_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Active Geofence:\n📍 Lat: 6.9271\n📍 Lng: 79.8612\n📍 Radius: 100m"
        android:textSize="16sp"
        android:gravity="center"
        android:background="#f0f0f0"
        android:padding="16dp"
        android:layout_marginBottom="24dp"
        android:lineSpacingExtra="6dp" />

    <!-- Start Button -->
    <Button
        android:id="@+id/start_geofence_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🚀 START GEOFENCE"
        android:textSize="16sp"
        android:backgroundTint="#4CAF50" />

    <!-- Stop Button -->
    <Button
        android:id="@+id/stop_geofence_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🛑 STOP GEOFENCE"
        android:textSize="16sp"
        android:backgroundTint="#F44336"
        android:layout_marginTop="12dp" />

    <!-- Event Log Area -->
    <TextView
        android:id="@+id/event_log_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="24dp"
        android:background="#e8e8e8"
        android:padding="16dp"
        android:text="📋 Events will appear here..."
        android:textSize="14sp"
        android:gravity="top"
        android:scrollbars="vertical"
        android:minHeight="150dp" />

</LinearLayout>